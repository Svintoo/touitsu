.{
    .primary = .{ .hex = "#d4d4d4" },
    .secondary = .{ .hex = "#a8a8a8" },
    .success = .{ .hex = "#bcbcbc" },
    .info = .{ .hex = "#9d9d9d" },
    .warning = .{ .hex = "#e0e0e0" },
    .@"error" = .{ .hex = "#7a7a7a" },
    .on_primary = .{ .hex = "#121212" },
    .on_secondary = .{ .hex = "#121212" },
    .on_success = .{ .hex = "#121212" },
    .on_info = .{ .hex = "#121212" },
    .on_warning = .{ .hex = "#121212" },
    .on_error = .{ .hex = "#f5f5f5" },
    .bg = .{ .hex = "#121212" },
    .elevated = .{ .hex = "#1b1b1b" },
    .muted = .{ .hex = "#242424" },
    .accented = .{ .hex = "#f0f0f0" },
    .inverted = .{ .hex = "#f5f5f5" },
    .text = .{ .hex = "#dddddd" },
    .highlighted = .{ .hex = "#ffffff" },
    .toned = .{ .hex = "#5e5e5e" },
    .dimmed = .{ .hex = "#969696" },
    .radius = 6,
    .scrollbar_thickness = 8,
    .scrollbar_min_thumb = 24,
    .scrollbar_track_color = .{ .hex = "#24242480" },
    .scrollbar_thumb_color = .{ .hex = "#666666" },
    .scrollbar_thumb_hover_color = .{ .hex = "#dcdcdc" },
    .scrollbar_corner_radius = 4,
}
