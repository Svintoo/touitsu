.{
    .primary = .{ .hex = "#7cdbff" },
    .secondary = .{ .hex = "#b67cff" },
    .success = .{ .hex = "#5df0a8" },
    .info = .{ .hex = "#5fc8ff" },
    .warning = .{ .hex = "#ffd166" },
    .@"error" = .{ .hex = "#ff6b7a" },
    .on_primary = .{ .hex = "#07161c" },
    .on_secondary = .{ .hex = "#170c22" },
    .on_success = .{ .hex = "#06180f" },
    .on_info = .{ .hex = "#06141c" },
    .on_warning = .{ .hex = "#221704" },
    .on_error = .{ .hex = "#25070b" },
    .bg = .{ .hex = "#101114" },
    .elevated = .{ .hex = "#191b20" },
    .muted = .{ .hex = "#272a31" },
    .accented = .{ .hex = "#f0f4ff" },
    .inverted = .{ .hex = "#f6f7fb" },
    .text = .{ .hex = "#eceff5" },
    .highlighted = .{ .hex = "#ffffff" },
    .toned = .{ .hex = "#555a66" },
    .dimmed = .{ .hex = "#a7adb9" },
    .radius = 4,
    .scrollbar_thickness = 8,
    .scrollbar_min_thumb = 24,
    .scrollbar_track_color = .{ .hex = "#272a3180" },
