.{
    .primary = .{ .hex = "#4f9cff" },
    .secondary = .{ .hex = "#7c5cff" },
    .success = .{ .hex = "#38c99b" },
    .info = .{ .hex = "#35c2e8" },
    .warning = .{ .hex = "#f0b84a" },
    .@"error" = .{ .hex = "#f06464" },
    .on_primary = .{ .hex = "#ffffff" },
    .on_secondary = .{ .hex = "#ffffff" },
    .on_success = .{ .hex = "#071b16" },
    .on_info = .{ .hex = "#06191f" },
    .on_warning = .{ .hex = "#241804" },
    .on_error = .{ .hex = "#ffffff" },
    .bg = .{ .hex = "#07111f" },
    .elevated = .{ .hex = "#0d1b2e" },
    .muted = .{ .hex = "#17263a" },
    .accented = .{ .hex = "#dcecff" },
    .inverted = .{ .hex = "#f6fbff" },
    .text = .{ .hex = "#e8f1ff" },
    .highlighted = .{ .hex = "#ffffff" },
    .toned = .{ .hex = "#52657f" },
    .dimmed = .{ .hex = "#9eb0c8" },
    .radius = 8,
    .scrollbar_thickness = 8,
    .scrollbar_min_thumb = 24,
    .scrollbar_track_color = .{ .hex = "#17263a80" },
