.{
    .primary = .{ .hex = "#5e81ac" },
    .secondary = .{ .hex = "#81a1c1" },
    .success = .{ .hex = "#8fbc8f" },
    .info = .{ .hex = "#88c0d0" },
    .warning = .{ .hex = "#d08770" },
    .@"error" = .{ .hex = "#bf616a" },
    .on_primary = .{ .hex = "#ffffff" },
    .on_secondary = .{ .hex = "#1f2933" },
    .on_success = .{ .hex = "#1d2a1d" },
    .on_info = .{ .hex = "#1d2b30" },
    .on_warning = .{ .hex = "#2b1810" },
    .on_error = .{ .hex = "#ffffff" },
    .bg = .{ .hex = "#eceff4" },
    .elevated = .{ .hex = "#f8fafc" },
    .muted = .{ .hex = "#d8dee9" },
    .accented = .{ .hex = "#2e3440" },
    .inverted = .{ .hex = "#2e3440" },
    .text = .{ .hex = "#2e3440" },
    .highlighted = .{ .hex = "#000000" },
    .toned = .{ .hex = "#b7c0cc" },
    .dimmed = .{ .hex = "#667285" },
    .radius = 7,
    .scrollbar_thickness = 8,
    .scrollbar_min_thumb = 24,
    .scrollbar_track_color = .{ .hex = "#d8dee980" },
    .scrollbar_thumb_color = .{ .hex = "#9aa7b8" },
    .scrollbar_thumb_hover_color = .{ .hex = "#2e3440" },
    .scrollbar_corner_radius = 4,
}
