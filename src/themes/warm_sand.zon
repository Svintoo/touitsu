.{
    .primary = .{ .hex = "#c76f3a" },
    .secondary = .{ .hex = "#8f6a42" },
    .success = .{ .hex = "#5f8f5a" },
    .info = .{ .hex = "#3f86a6" },
    .warning = .{ .hex = "#d9982f" },
    .@"error" = .{ .hex = "#b8483e" },
    .on_primary = .{ .hex = "#ffffff" },
    .on_secondary = .{ .hex = "#ffffff" },
    .on_success = .{ .hex = "#ffffff" },
    .on_info = .{ .hex = "#ffffff" },
    .on_warning = .{ .hex = "#2b1b08" },
    .on_error = .{ .hex = "#ffffff" },
    .bg = .{ .hex = "#fbf3e6" },
    .elevated = .{ .hex = "#fffaf2" },
    .muted = .{ .hex = "#eadcc8" },
    .accented = .{ .hex = "#2f261d" },
    .inverted = .{ .hex = "#1f1a16" },
    .text = .{ .hex = "#2c241b" },
    .highlighted = .{ .hex = "#000000" },
    .toned = .{ .hex = "#c8b69d" },
    .dimmed = .{ .hex = "#7b6a57" },
    .radius = 10,
    .scrollbar_thickness = 8,
    .scrollbar_min_thumb = 24,
    .scrollbar_track_color = .{ .hex = "#eadcc880" },
