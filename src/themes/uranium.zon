    .on_info = .{ .hex = "#092022" },
    .on_warning = .{ .hex = "#252006" },
    .on_error = .{ .hex = "#2b0d0c" },
    .bg = .{ .hex = "#0a0e0a" },
    .elevated = .{ .hex = "#121a12" },
    .muted = .{ .hex = "#202d1b" },
    .accented = .{ .hex = "#e8ffcc" },
    .inverted = .{ .hex = "#f0ffe5" },
    .text = .{ .hex = "#e6efdf" },
    .highlighted = .{ .hex = "#385a1f" },
    .toned = .{ .hex = "#52633c" },
    .dimmed = .{ .hex = "#a0b18f" },
